# 文件职责：列出远程 Docker Compose 运行所需的环境变量模板。
# 主要内容：Web 绑定、PostgreSQL、Session、OpenRouter 模型参数与密钥占位符。
# 关键边界：仅声明变量名和非敏感默认值；密码、Session Secret 与 API Key 必须在远程环境单独填写。
WEB_BIND_IP=127.0.0.1
WEB_PORT=8380
PUBLIC_WEB_ORIGIN=http://localhost:8380

POSTGRES_DB=bankpilot
POSTGRES_USER=bankpilot
POSTGRES_PASSWORD=
POSTGRES_BIND_IP=127.0.0.1
POSTGRES_HOST_PORT=55433

BANKPILOT_SESSION_SECRET=
BANKPILOT_SESSION_TTL_SECONDS=28800
BANKPILOT_SESSION_COOKIE_SECURE=false

MODEL_ID=google/gemini-2.5-flash
MODEL_TIMEOUT_SECONDS=30
MODEL_MAX_RETRIES=1
MODEL_MAX_TOKENS=1600
MODEL_REASONING_EFFORT=low
OPENROUTER_API_KEY=
