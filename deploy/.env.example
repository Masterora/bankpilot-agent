# 远程配置示例。Web 绑定 Tailscale 地址，凭据在远程单独配置。
WEB_BIND_IP=100.64.0.1
WEB_PORT=8380
PUBLIC_WEB_ORIGIN=http://100.64.0.1:8380
BANKPILOT_SESSION_COOKIE_SECURE=false

POSTGRES_DB=bankpilot
POSTGRES_USER=bankpilot
POSTGRES_PASSWORD=
# 数据库由同一远程 Compose 管理；不发布到 Tailscale 或公网。
POSTGRES_BIND_IP=127.0.0.1
POSTGRES_HOST_PORT=55433

BANKPILOT_SESSION_SECRET=
BANKPILOT_TIMEZONE=Asia/Shanghai
BANKPILOT_SESSION_TTL_SECONDS=28800
BANKPILOT_RECURRING_DISCOVERY_ENABLED=false
BANKPILOT_NOTIFICATIONS_ENABLED=false
BANKPILOT_NOTIFICATION_EPOCH=r7-v1
# 助手及安全限额默认值见根目录 .env.example；需要覆盖时在此文件添加对应变量。
MODEL_ID=google/gemini-2.5-flash
MODEL_TIMEOUT_SECONDS=30
MODEL_MAX_RETRIES=1
MODEL_MAX_TOKENS=1600
MODEL_REASONING_EFFORT=low
OPENROUTER_API_KEY=

# Optional provider integrations; keep disabled until credentials and HTTPS callbacks are ready.
BANKPILOT_PUBLIC_URL=
FEISHU_ENABLED=false
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_ENCRYPT_KEY=
FEISHU_VERIFICATION_TOKEN=
FEISHU_TENANT_KEY=
ALIPAY_SANDBOX_ENABLED=false
ALIPAY_SANDBOX_APP_ID=
ALIPAY_SANDBOX_SELLER_ID=
# PEM content; literal \n is supported. Never use real-payment credentials.
ALIPAY_SANDBOX_PRIVATE_KEY=
ALIPAY_SANDBOX_PUBLIC_KEY=
