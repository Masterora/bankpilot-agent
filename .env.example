# 文件职责：列出本地开发所需的环境变量模板。
# 主要内容：API 地址、SSH 隧道数据库连接、会话、业务时区与模型配置占位符。
# 关键边界：仅提供示例，不含有效凭据；本地实际配置不得提交。
BANKPILOT_API_ORIGIN=http://127.0.0.1:8000
BANKPILOT_ENV=development
# Agent 相对日期的业务时区；页面时间显示使用 UTC+8。
BANKPILOT_TIMEZONE=Asia/Shanghai
BANKPILOT_DATABASE_URL=postgresql+asyncpg://bankpilot:replace-me@127.0.0.1:55433/bankpilot
BANKPILOT_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
BANKPILOT_SESSION_COOKIE_SECURE=false
BANKPILOT_RECURRING_DISCOVERY_ENABLED=false
BANKPILOT_NOTIFICATIONS_ENABLED=false
# 每次重新启用须更换 epoch；所有实例使用相同值，以重新建立不补发的基线。
BANKPILOT_NOTIFICATION_EPOCH=r7-v1
MODEL_PROVIDER=openrouter
MODEL_ID=
OPENROUTER_API_KEY=

# 共享数据库中的认证、模型用量和流连接限额；UTC 固定日窗口。
ASSISTANT_MAX_CONVERSATIONS=100
ASSISTANT_MAX_TURNS=200
ASSISTANT_MAX_RESULT_CHARS=400000
ASSISTANT_CONTEXT_CHARS=24000
AUTH_GLOBAL_PER_MINUTE=60
AUTH_SOURCE_PER_MINUTE=20
AUTH_ACCOUNT_PER_MINUTE=8
PASSWORD_CONCURRENCY=4
MODEL_USER_ACTIVE=2
MODEL_GLOBAL_ACTIVE=8
MODEL_USER_JOBS_DAILY=40
MODEL_GLOBAL_JOBS_DAILY=400
MODEL_USER_ATTEMPTS_DAILY=240
MODEL_GLOBAL_ATTEMPTS_DAILY=2400
MODEL_USER_TOKENS_DAILY=2000000
MODEL_GLOBAL_TOKENS_DAILY=20000000
STREAM_USER_ACTIVE=2
STREAM_GLOBAL_ACTIVE=16
