BANKPILOT_ENV=development
BANKPILOT_DATABASE_URL=postgresql+asyncpg://bankpilot:replace-me@db.internal:5432/bankpilot
BANKPILOT_SESSION_SECRET=replace-with-at-least-32-random-characters
BANKPILOT_SESSION_TTL_SECONDS=28800
BANKPILOT_SESSION_COOKIE_SECURE=false
BANKPILOT_CORS_ORIGINS=http://localhost:5173

MODEL_PROVIDER=openrouter
MODEL_ID=
MODEL_BASE_URL=https://openrouter.ai/api/v1
MODEL_TIMEOUT_SECONDS=30
MODEL_MAX_RETRIES=1
MODEL_MAX_TOKENS=1600
MODEL_REASONING_EFFORT=low
MODEL_REQUIRE_PARAMETERS=true
MODEL_DATA_COLLECTION=deny
OPENROUTER_API_KEY=
